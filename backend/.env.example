# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers → copy the connection string.
# Also allow your IP under Atlas → Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=lms
MONGODB_DB_NAME=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB_NAME=lms
# Optional. Set if startup fails with `querySrv ECONNREFUSED` (Node can't use your OS DNS server).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN_HOURS=24
# true when served over HTTPS (production)
COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Only needed for direct browser calls; the Next.js apps proxy /api to this server.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
